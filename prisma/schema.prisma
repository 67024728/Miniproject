generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Vocabulary {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  word String @unique
  pos String
  phonetic String
  transtlation String
  alphabet String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alphabet])
}